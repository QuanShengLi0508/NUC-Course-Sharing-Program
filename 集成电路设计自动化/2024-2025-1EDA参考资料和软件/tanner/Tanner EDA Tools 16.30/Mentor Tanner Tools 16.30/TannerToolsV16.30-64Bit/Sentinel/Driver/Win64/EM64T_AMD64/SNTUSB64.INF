; Rainbow Technologies Sentinel SuperPro USB driver INF file
;
; Copyright (C) 2000 Rainbow Technologies, All rights reserved.

[Version]
Signature="$CHICAGO$"
Class=USB
ClassGuid={36fc9e60-c465-11cf-8056-444553540000}
CatalogFile.nt=sntusb64.cat
provider=%Rainbow%
DriverVer=10/11/2004, 5.40.0.0

[Manufacturer]
%Rainbow%=Rainbow,NTamd64

[Rainbow.NTamd64]
%USB\VID_04B9&PID_0300.DeviceDesc%=SNTUSB64, USB\VID_04B9&PID_0300

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
SNTUSB64.SYS=1,,

[ControlFlags]
; All PnP devices should be excluded from manual AddDevice Applet list
ExcludeFromSelect = USB\VID_04B9&PID_0300

[DestinationDirs]
DefaultDestDir = 12
SNTUSB64.SysCopy = 10,System32\Drivers

[SNTUSB64.NT]
CopyFiles=SNTUSB64.SysCopy

[SNTUSB64.SysCopy]
SNTUSB64.SYS

[SNTUSB64.nt.Services]
Addservice = SNTUSB64, 0x00000002, SNTUSB64.AddService

[SNTUSB64.AddService]
DisplayName    = %SNTUSB64.SvcDesc%
ServiceType    = 1 ; SERVICE_KERNEL_DRIVER
StartType      = 3 ; SERVICE_DEMAND_START
ErrorControl   = 1 ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\SNTUSB64.SYS
AddReg = SNTUSB64.AddReg.nt
LoadOrderGroup = Base

[SNTUSB64.AddReg.nt]
;HKLM,"System\Currentcontrolset\Services\Sentinel\Setup","UsbSupport",0x10001,1
;HKLM,"System\Currentcontrolset\Services\SntUsb64\Current","VersionString",0x0000,"5.40.0"


[Strings]
Rainbow="Rainbow Technologies, Inc."
USB\VID_04B9&PID_0300.DeviceDesc="Rainbow USB SuperPro"
SNTUSB64.SvcDesc="Rainbow USB SuperPro\UltraPro"
DiskName="Sentinel System Driver Installation Disk"
DisplayClassName="Software Security Token"