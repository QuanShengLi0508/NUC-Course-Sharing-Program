`timescale 1ns / 1ns
`include "JK_FF.v"
module JK_FF_tb;
    // Declare inputs as registers and outputs as wires
    reg CLK;
    reg J;
    reg K;
    reg SET;
    reg RS;
    wire Q;

    // Instantiate the JK_FF module
    JK_FF uut (
        .CLK(CLK),
        .J(J),
        .K(K),
        .SET(SET),
        .RS(RS),
        .Q(Q)
    );

    initial begin
        // Monitor the inputs and output
        $monitor("Time = %0d, CLK = %b, J = %b, K = %b, SET = %b, RS = %b, Q = %b", 
                 $time, CLK, J, K, SET, RS, Q);

        // Initialize inputs
        CLK = 0;
        SET = 1;
        RS = 1;
        Q = 0;

        // Test Case 1: J=0, K=0 (No change)
        J = 0; K = 0; #20; CLK = 1; #20; CLK = 0; #20;

        // Test Case 2: J=0, K=1 (Reset)
        J = 0; K = 1; #20; CLK = 1; #20; CLK = 0; #20;

        // Test Case 3: J=1, K=0 (Set)
        J = 1; K = 0; #20; CLK = 1; #20; CLK = 0; #20;

        // Test Case 4: J=1, K=1 (Toggle)
        J = 1; K = 1; #20; CLK = 1; #20; CLK = 0; #20;
        J = 1; K = 1; #20; CLK = 1; #20; CLK = 0; #20; // Toggle again

        // Test Case 5: Active low RS (Reset)
        RS = 0; #20; RS = 1; #20;

        // Test Case 6: Active low SET (Set)
        SET = 0; #20; SET = 1; #20;

        J = 1'bz; K = 1'bz; #20; CLK = 1; #20; CLK = 0; #20;

        // End the simulation
        #200; 
        $stop;
    end
endmodule
