`timescale 1ns/1ns

`include "adder4.v"

module adder_tb;
    reg [3:0] a, b;
    reg cin;
    wire [3:0] sum;
    wire cout;
    integer i, j;

    // ???adder4??
    adder4 adder(sum, cout, a, b, cin);

    // ??????5ns??cin
    always #5 cin = ~cin;

    // ??????a??
    initial begin
        a = 0;
        b = 0;
        cin = 0;  // ???cin
        for (i = 1; i < 9; i = i + 1)
        #10 a = i;
    end

    // ??b??
    initial begin
        for (j = 0; j < 8; j = j + 1)
        #10 b = j;
    end

    // ????
    initial begin
        $monitor($time, " : %d + %d + %b = {%b, %b}", a, b, cin, sum, cout);
        #160 $stop;
    end
endmodule