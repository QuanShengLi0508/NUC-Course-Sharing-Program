#NET clk_i                   TNM_NET = sys_clk_pin;
#TIMESPEC TS_sys_clk_pin = PERIOD sys_clk_pin 50000 kHz;

NET sys_clk          LOC = N8 | IOSTANDARD = "LVCMOS33";   
NET sys_rst_n        LOC = G16 | IOSTANDARD = "LVCMOS33";


NET "da_clk"                       LOC = J13 | IOSTANDARD = "LVCMOS33"; 


NET "da_data[0]"                    LOC = H11 | IOSTANDARD = "LVCMOS33"; 
NET "da_data[1]"                    LOC = G12 | IOSTANDARD = "LVCMOS33"; 
NET "da_data[2]"                    LOC = H13 | IOSTANDARD = "LVCMOS33"; 
NET "da_data[3]"                    LOC = F13 | IOSTANDARD = "LVCMOS33"; 
NET "da_data[4]"                    LOC = K11 | IOSTANDARD = "LVCMOS33"; 
NET "da_data[5]"                    LOC = J12 | IOSTANDARD = "LVCMOS33"; 
NET "da_data[6]"                   LOC = M13 | IOSTANDARD = "LVCMOS33"; 
NET "da_data[7]"                    LOC = K12 | IOSTANDARD = "LVCMOS33"; 


NET "key1"                    LOC = p5 | IOSTANDARD = "LVCMOS33"; 
NET "key2"                    LOC = n5 | IOSTANDARD = "LVCMOS33"; 


