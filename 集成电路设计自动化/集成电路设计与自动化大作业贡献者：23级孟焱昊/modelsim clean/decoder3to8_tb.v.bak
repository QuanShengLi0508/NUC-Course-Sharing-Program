`timescale 1ns/1ps
module decoder3to8_tb;

reg       en;
reg [2:0] in;
wire[7:0] out;

integer i;

// 实例化待测模块
decoder3to8 u0 (
    .en(en),
    .in(in),
    .out(out)
);

initial begin
    // 生成 VCD 波形文件（GTKWave 可打开）
    $dumpfile("decoder3to8.vcd");
    $dumpvars(0, decoder3to8_tb);

    // 测试序列
    en = 0; in = 3'b000; #10;
    en = 1;              #10;
    for (i = 0; i < 8; i = i + 1) begin
        in = i; #10;
    end
    en = 0;              #10;

    $display("Simulation Finished");
    $finish;
end

endmodule
